# Any LiteLLM model string with a provider prefix. Hosted providers read their own key.
MODEL_NAME="anthropic/claude-sonnet-4-5"
ANTHROPIC_API_KEY=

# Local OpenAI-compatible server (llama.cpp, vLLM, Ollama) instead:
# MODEL_NAME="openai/qwen3.6"
# LLM_API_BASE=http://127.0.0.1:8090/v1
# LLM_API_KEY=sk-local

LLM_MAX_TOKENS=2048

# Contributed agents: comma-separated importable packages installed into this
# environment (see "uv add --group agents"). Importing registers the manifest.
# PLUGBOARD_EXTRA_AGENTS=plugboard_weather,plugboard_genbi,plugboard_hotel

# Contributed skill agents: comma-separated paths to skill repositories (each holds a SKILL.md).
# PLUGBOARD_EXTRA_SKILLS=../plugboard-inventory
